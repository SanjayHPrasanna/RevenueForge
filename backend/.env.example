# Copy to backend/.env and fill in what you need. Everything is optional for a local demo.

# --- AI engine: gemini | anthropic | openai | azure | none (rules engine only) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Leave empty to use the newest stable Gemini Flash model automatically, or pin one, e.g. gemini-2.5-flash
GEMINI_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001
# Requests per minute RevenueForge allows itself (free Gemini keys allow roughly 10/min)
LLM_RPM=8
# true once the key belongs to a billed Google Cloud project (paid tier: Google does not use your data to improve its products)
LLM_PAID=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Database: SQLite by default (zero setup). For Postgres: ---
# DATABASE_URL=postgresql+psycopg2://revenueforge:revenueforge@localhost:5432/revenueforge

# --- Security ---
# JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=40

# Indicative exchange rates per 1 USD, used when the RFP currency differs from your rate card (optional)
# FX_RATES=AUD=1.52,EUR=0.92,GBP=0.79

# --- Sign in with Google ---
# The team's Google client ID is already set in backend/team.env (shared through git), so you don't need it here.
# Only set it here to use a different Google client on your machine; your value overrides the team one.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Only allow these Google domains (optional, comma-separated):
# GOOGLE_ALLOWED_DOMAINS=yourcompany.com

# --- Email: "your deal is ready for review" ---
# Leave SMTP_HOST empty to send no emails. Gmail: turn on 2-step verification, create an app password at
# myaccount.google.com/apppasswords, then use smtp.gmail.com / 587 / your Gmail address / the 16-letter app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown in the email (empty = SMTP_USER) and the sender name
SMTP_FROM=
SMTP_FROM_NAME=RevenueForge
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
# Address people open the app at, used for the link in emails (on Azure: https://<your-app>.azurewebsites.net)
APP_URL=http://localhost:5173

# --- Sign in with Microsoft (work accounts) ---
# Azure portal → Microsoft Entra ID → App registrations → New registration. Platform "Single-page application" with
# redirect URI http://localhost:5173/auth/microsoft (and your Azure address + /auth/microsoft later). Under
# Authentication, tick "ID tokens". Copy the Application (client) ID here. MS_TENANT_ID = your Directory (tenant) ID to
# allow only your organisation, or "organizations" for any work account.
MS_CLIENT_ID=
MS_TENANT_ID=organizations
MS_ALLOWED_DOMAINS=

# --- Maahi chat assistant ---
# Optional free Gemini key used only by Maahi (the chat bubble), for every visitor and every company.
# Keeps chat from using the main key's quota. Leave empty to use the main AI.
MAAHI_GEMINI_API_KEY=

# --- Solution video (Proposal stage) ---
# Optional second free Gemini key used only to write the video narration, so it doesn't use up the main key's quota.
# GEMINI_VIDEO_API_KEY=
# Optional: the computer voice to use (Windows examples: "Microsoft Zira Desktop", "Microsoft David Desktop"). Empty = automatic.
# VIDEO_VOICE=

# --- Who can change the AI engine from Settings → AI engine (comma-separated emails) ---
# The AI provider and key are shared by every company on this server, so only these people can change them.
# PLATFORM_ADMINS=you@yourcompany.com
